{
  "name": "aasha-offline-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/api-integration.mjs",
    "audit": "node scripts/audit-repo.mjs",
    "format:check": "prettier --check src worker tests scripts *.json *.jsonc *.html",
    "check:docs": "node scripts/map-brief.mjs --check && node scripts/check-docs.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "worker:dev": "wrangler dev --port 8787",
    "worker:check": "wrangler deploy --dry-run --env preview",
    "db:migrate:local": "wrangler d1 migrations apply aasha-local --local",
    "deploy:preview": "node scripts/deploy-check.mjs preview",
    "deploy:production": "node scripts/deploy-check.mjs production",
    "build:ci": "npm run audit && npm run check:docs && npm test && npm run build",
    "predeploy:preview": "npm run build:ci",
    "deploy:check": "node scripts/deploy-check.mjs preview --check",
    "build:pages": "node scripts/build-pages.mjs",
    "check:screens": "node scripts/gen-screens.mjs --check",
    "check:pages": "node scripts/check-pages.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/supabase-js": "2.117.3",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "fake-indexeddb": "6.2.5",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  }
}
