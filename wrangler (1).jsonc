{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aasha-offline-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "DEMO_MODE": "offline-synthetic" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "d1_databases": [{ "binding": "DB", "database_name": "aasha-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "database/migrations" }],
  "env": {
    "preview": {
      "name": "aasha-offline-preview",
      "vars": { "DEMO_MODE": "offline-synthetic" },
      "d1_databases": [{ "binding": "DB", "database_name": "aasha-preview", "database_id": "REPLACE_WITH_PREVIEW_D1_ID", "migrations_dir": "database/migrations" }]
    }
  }
}
